<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the plugin project -->
    <ProjectReference Include="..\IArchitecture.SemgrepValidator.csproj" />
  </ItemGroup>

  <!-- Copy the test file from parent directory -->
  <ItemGroup>
    <Compile Include="..\TestSemgrepFFI.cs" Link="TestSemgrepFFI.cs" />
  </ItemGroup>

  <!-- Ensure FFI DLLs are copied to output directory root (for Windows DLL loading) -->
  <ItemGroup>
    <None Include="..\ffi\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Copy to root, not subfolder, so Windows can find dependencies -->
    </None>
  </ItemGroup>

</Project>
