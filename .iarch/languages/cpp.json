{
  "language": "cpp",
  "displayName": "C++",
  "fileExtensions": [".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx", ".h"],
  "layerDetection": {
    "layers": {
      "Core": {
        "namespacePatterns": [".*::core$", ".*::engine$"],
        "importPatterns": [".*core.*", ".*engine.*"]
      },
      "Utils": {
        "namespacePatterns": [".*::utils?$", ".*::helpers?$"],
        "importPatterns": [".*util.*", ".*helper.*"]
      },
      "API": {
        "namespacePatterns": [".*::api$", ".*::interface$"],
        "importPatterns": [".*api.*", ".*interface.*"]
      }
    }
  },
  "parsingPatterns": {
    "namespace": "^\\s*namespace\\s+([\\w:]+)\\s*\\{",
    "import": "^\\s*#include\\s*[<\"](?<module>[^>\"]+)[>\"]",
    "typeDeclaration": "^\\s*(?:template\\s*<[^>]*>\\s*)?(?:class|struct|enum(?:\\s+class)?)\\s+(\\w+)(?:\\s*(?:[:{]|:\\s*(?:public|protected|private)))",
    "typeKeywords": ["class", "struct", "enum"],
    "methodDeclaration": "^\\s*(?:virtual\\s+)?(?:static\\s+)?(?:inline\\s+)?([\\w:]+(?:<[^>]+>)?)\\s+([\\w:]+)\\s*\\(([^)]*)\\)",
    "instantiation": "\\bnew\\s+([\\w:]+)(?:<[^>]*>)?\\s*\\(",
    "commentSingleLine": "//(.*)$",
    "commentMultiLine": "/\\*(.*?)\\*/",
    "commentDocumentation": "///(.*)$"
  },
  "formattingRules": {
    "indentSize": 2,
    "increaseIndentTriggers": ["{"],
    "decreaseIndentTriggers": ["}"],
    "decreaseBeforeLine": true
  },
  "syntaxValidation": {
    "balancedPairs": [
      { "open": "(", "close": ")" },
      { "open": "[", "close": "]" },
      { "open": "{", "close": "}" },
      { "open": "<", "close": ">" }
    ]
  },
  "commentStyles": ["//", "/*", "///"]
}
