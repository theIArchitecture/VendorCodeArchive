{
  "language": "javascript",
  "displayName": "JavaScript",
  "fileExtensions": [".js", ".mjs", ".cjs"],
  "layerDetection": {
    "layers": {
      "Repository": {
        "namespacePatterns": [".*\\.repositories?$", ".*\\.data$"],
        "importPatterns": [".*repository.*", ".*dal.*", ".*data.*"]
      },
      "Domain": {
        "namespacePatterns": [".*\\.domain$", ".*\\.models?$", ".*\\.entities$"],
        "importPatterns": [".*domain.*", ".*model.*", ".*entity.*"]
      },
      "Service": {
        "namespacePatterns": [".*\\.services?$", ".*\\.application$"],
        "importPatterns": [".*service.*", ".*application.*"]
      },
      "Controller": {
        "namespacePatterns": [".*\\.controllers?$", ".*\\.api$"],
        "importPatterns": [".*controller.*", ".*api.*", ".*routes.*"]
      }
    }
  },
  "parsingPatterns": {
    "import": "^\\s*import\\s+(?:\\{(?<symbols>[^}]+)\\}|\\*\\s+as\\s+(?<alias>\\w+)|(?<alias>\\w+))\\s+from\\s+['\"](?<module>[^'\"]+)['\"]",
    "typeDeclaration": "(?:export\\s+)?(?:default\\s+)?(class)\\s+(\\w+)(?:\\s+extends\\s+([\\w\\.]+))?",
    "typeKeywords": ["class"],
    "methodDeclaration": "(?:async\\s+)?(\\w+)\\s*\\(([^)]*)\\)\\s*\\{",
    "instantiation": "new\\s+([\\w\\.]+)\\s*\\(",
    "commentSingleLine": "//(.*)$",
    "commentMultiLine": "/\\*(.*?)\\*/",
    "commentDocumentation": "/\\*\\*(.*)\\*/"
  }
}
