# Immutability at Boundaries Rule (VSCode Configuration)
# Ensures types crossing module boundaries are immutable (prevents accidental state mutation)
# Critical for thread-safety, functional programming patterns, and preventing bugs

RULE "IMMUTABILITY-AT-BOUNDARIES" : IMetaArchitecture
  ID: "ARCH-IMMUTABILITY-001"
  DESCRIPTION: "Public API type has mutable properties - types crossing boundaries should be immutable"
  SEVERITY: Error
  CATEGORY: "Architecture_Quality"
  APPLIES_TO: ["csharp"]

  PLUGIN:
    ID: "architecture-validator"
    SCOPE: "tree"
    CONFIG:
      validator: "Immutability"
      target_namespaces: "[\"*Config\",\"*Options\",\"*Model\",\"*DTO\",\"IEditor*\",\"IText*\"]"
      message: "Public API types must be immutable (readonly properties, no public setters)"

  EDUCATION:
    DOCS_URL: "https://en.wikipedia.org/wiki/Immutable_object"
    WHY_IT_MATTERS: "This rule ensures that data types used across multiple components are consistent and predictable. Immutable types prevent unintended side effects, race conditions, and make code easier to reason about."
    BUSINESS_IMPACT: "Mutable shared state is a major source of bugs in large codebases. Immutability reduces debugging time and prevents data corruption issues."
    QUICK_FIX: "Make properties readonly. For TypeScript, use 'readonly' modifier. Remove setters and use constructor initialization or object spread for updates. Consider using immutable data structures."

  ARCHITECTURAL_CONTEXT:
    PROJECT_TYPE: "IDE"
    ARCHITECTURE_PATTERN: "Layered"
    DESIGN_PRINCIPLES: ["Immutability", "Thread_Safety", "Predictability"]

  VIOLATIONS:
    - "Type '{{TYPE}}' has mutable property '{{PROPERTY}}' - make it readonly"
    - "Public API should use immutable data structures"

END_RULE
