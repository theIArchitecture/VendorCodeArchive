# Aggregate Boundary Enforcement Rule (VSCode Configuration)
# Detects violations of DDD aggregate boundaries
# Aggregate members can only be accessed through the aggregate root

RULE "AGGREGATE-BOUNDARY-ENFORCEMENT" : IMetaArchitecture
  ID: "ARCH-AGGREGATE-001"
  DESCRIPTION: "Aggregate boundary violation - aggregate member accessed from outside its aggregate"
  SEVERITY: Error
  CATEGORY: "Architecture_Quality"
  APPLIES_TO: ["csharp", "java", "python", "typescript", "javascript"]

  PLUGIN:
    ID: "architecture-validator"
    SCOPE: "tree"
    CONFIG:
      validator: "AggregateBoundary"
      aggregate_roots: "[\"EditorService\",\"TextEditor\",\"WorkbenchContribution\"]"
      aggregate_members: "[\"*Impl\",\"*.internal.*\",\"*Internal*\"]"

  EDUCATION:
    DOCS_URL: "https://martinfowler.com/bliki/DDD_Aggregate.html"
    WHY_IT_MATTERS: "Aggregate boundaries enforce encapsulation in Domain-Driven Design. All external access to an aggregate must go through the aggregate root, ensuring consistency and invariant enforcement."
    BUSINESS_IMPACT: "Violated aggregate boundaries lead to tight coupling, making the codebase fragile and difficult to evolve. Changes cascade unpredictably across aggregates."
    QUICK_FIX: "Route all access through the aggregate root. If you need to access internal members, expose them through the root's public API or reconsider the aggregate boundary design."

  ARCHITECTURAL_CONTEXT:
    PROJECT_TYPE: "IDE"
    ARCHITECTURE_PATTERN: "Layered"
    DESIGN_PRINCIPLES: ["Encapsulation", "Aggregate_Consistency", "Single_Entry_Point"]

  VIOLATIONS:
    - "Aggregate member '{{MEMBER}}' accessed from outside aggregate '{{ROOT}}'"
    - "Direct access to internal implementation - use aggregate root instead"

END_RULE
