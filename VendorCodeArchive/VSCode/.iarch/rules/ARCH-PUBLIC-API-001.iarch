# Public API Surface Control Rule (VSCode Configuration)
# Ensures only intentional types are exposed publicly (prevents accidental API surface expansion)

RULE "PUBLIC-API-SURFACE-CONTROL" : IMetaArchitecture
  ID: "ARCH-PUBLIC-API-001"
  DESCRIPTION: "Public type exposed outside allowed public API namespaces"
  SEVERITY: Error
  CATEGORY: "Architecture_Quality"
  APPLIES_TO: ["csharp", "java", "python", "typescript", "javascript"]

  PLUGIN:
    ID: "architecture-validator"
    SCOPE: "tree"
    CONFIG:
      validator: "PublicApiSurface"
      allowed_public_namespaces: "[\"vs.editor.*\",\"vs.platform.*\",\"vscode.*\"]"
      forbidden_public_namespaces: "[\"*.internal.*\",\"*.test.*\",\"*Impl\"]"
      message: "Public types should not be exposed in internal/impl namespaces"

  EDUCATION:
    DOCS_URL: "https://code.visualstudio.com/api/references/vscode-api"
    WHY_IT_MATTERS: "Controlling the public API surface prevents accidental exposure of internal implementation details. This maintains backward compatibility and allows internal refactoring without breaking extensions."
    BUSINESS_IMPACT: "Uncontrolled API surface expansion creates maintenance burden and prevents breaking changes. Every exposed type becomes a compatibility contract."
    QUICK_FIX: "Mark internal types as non-exported or move them to internal namespaces. Use 'internal' visibility for implementation details. Only export types that are part of the stable public API."

  ARCHITECTURAL_CONTEXT:
    PROJECT_TYPE: "IDE"
    ARCHITECTURE_PATTERN: "Layered"
    DESIGN_PRINCIPLES: ["API_Stability", "Information_Hiding", "Backward_Compatibility"]

  VIOLATIONS:
    - "Public type '{{TYPE}}' should not be in internal namespace"
    - "Implementation detail leaked through public API"

END_RULE
