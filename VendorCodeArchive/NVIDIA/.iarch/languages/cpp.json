{
  "language": "cpp",
  "displayName": "C++ (NVIDIA/CUDA)",
  "fileExtensions": [".cpp", ".hpp", ".hxx", ".h++", ".inl"],

  "parsingPatterns": {
    "namespace": "^\\s*namespace\\s+([\\w:]+)\\s*(?:\\{|$)",
    "import": "^\\s*#include\\s+[\"<](?<module>[\\w/.]+)[\">]",
    "typeDeclaration": "(?:template\\s*<[^>]+>\\s*)?(class|struct|enum|union)\\s+(\\w+)(?:\\s*:\\s*(?:public|protected|private)\\s+([\\w:]+))?\\s*\\{",
    "typeKeywords": ["class", "struct", "enum", "union"],
    "methodDeclaration": "(?:virtual\\s+|static\\s+|inline\\s+|explicit\\s+|constexpr\\s+)*(?:[\\w:<>,\\s*&]+)\\s+(\\w+)\\s*\\(([^)]*)\\)(?:\\s*const)?(?:\\s*override)?(?:\\s*=\\s*(?:0|default|delete))?",
    "fieldDeclaration": "(?:public|private|protected)\\s*:\\s*(?:(?:static\\s+|mutable\\s+|const\\s+|constexpr\\s+)*)([\\w:<>,\\s*&]+)\\s+(\\w+)\\s*(?:;|=|\\{)",
    "instantiation": "(?:new\\s+|std::make_\\w+<|std::unique_ptr<|std::shared_ptr<)\\s*([\\w:]+)",
    "commentSingleLine": "//(.*)$",
    "commentMultiLine": "/\\*(.*?)\\*/",
    "commentDocumentation": "/\\*\\*(.*?)\\*/"
  },

  "plainImportBehavior": "skip",

  "layerDetection": {
    "layers": {
      "Internal": {
        "pathPatterns": [
          "\\\\detail\\\\",
          "\\\\internal\\\\",
          "\\\\agent\\\\",
          "\\\\dispatch\\\\",
          "cub\\\\util_",
          "thrust\\\\system\\\\detail\\\\"
        ],
        "namingPatterns": [
          ".*detail::.*",
          ".*internal::.*",
          "Agent.*",
          "Dispatch.*"
        ],
        "importPatterns": [
          ".*/detail/.*",
          ".*/internal/.*"
        ]
      },

      "Utility": {
        "pathPatterns": [
          "cub\\\\config",
          "thrust\\\\detail\\\\config",
          "cub\\\\util_type",
          "cub\\\\util_ptx",
          "\\\\type_traits\\\\",
          "\\\\functional\\\\"
        ],
        "namingPatterns": [
          ".*Traits$",
          ".*Config$",
          ".*Util$"
        ],
        "importPatterns": [
          ".*/config\\..*",
          ".*/type_traits/.*"
        ]
      },

      "PublicAPI": {
        "pathPatterns": [
          "thrust\\\\thrust\\\\[^d\\\\]",
          "cub\\\\cub\\\\device\\\\",
          "cub\\\\cub\\\\block\\\\",
          "cub\\\\cub\\\\warp\\\\",
          "cub\\\\cub\\\\thread\\\\",
          "cub\\\\cub\\\\grid\\\\",
          "cub\\\\cub\\\\iterator\\\\",
          "libcudacxx\\\\include\\\\",
          "cudax\\\\include\\\\"
        ],
        "namingPatterns": [
          "^thrust::.*",
          "^cub::Device.*",
          "^cub::Block.*",
          "^cub::Warp.*"
        ],
        "importPatterns": [
          "thrust/.*",
          "cub/device/.*",
          "cub/block/.*"
        ]
      }
    }
  },

  "fieldExtractionPatterns": [
    {
      "name": "field_declaration",
      "description": "Matches C++ field/member variable declarations",
      "pattern": "(?:public|private|protected)\\s*:\\s*(?:(?:static\\s+|mutable\\s+|const\\s+|constexpr\\s+)*)([\\w:<>,\\s*&]+)\\s+(\\w+)\\s*(?:;|=|\\{)",
      "typeGroup": 1,
      "nameGroup": 2,
      "isProperty": false
    },
    {
      "name": "member_variable",
      "description": "Matches member variables without explicit access modifier",
      "pattern": "^\\s+(?:static\\s+|mutable\\s+|const\\s+|constexpr\\s+)*([\\w:<>,\\s*&]+)\\s+(\\w+_)\\s*(?:;|=|\\{)",
      "typeGroup": 1,
      "nameGroup": 2,
      "isProperty": false
    },
    {
      "name": "using_declaration",
      "description": "Matches using type aliases",
      "pattern": "using\\s+(\\w+)\\s*=\\s*([\\w:<>,\\s*&]+)\\s*;",
      "typeGroup": 2,
      "nameGroup": 1,
      "isProperty": false
    },
    {
      "name": "typedef_declaration",
      "description": "Matches typedef declarations",
      "pattern": "typedef\\s+([\\w:<>,\\s*&]+)\\s+(\\w+)\\s*;",
      "typeGroup": 1,
      "nameGroup": 2,
      "isProperty": false
    }
  ],

  "transformationRules": {
    "importTemplate": "#include \"{namespace}\"",
    "importInsertLocation": "after_last_import",
    "importRemovalPattern": "^\\s*#include\\s+[\"<]{namespace}[\">]\\s*$"
  },

  "formattingRules": {
    "indentSize": 2,
    "increaseIndentTriggers": ["{"],
    "decreaseIndentTriggers": ["}"],
    "decreaseBeforeLine": true
  },

  "syntaxValidation": {
    "balancedPairs": [
      { "open": "{", "close": "}" },
      { "open": "(", "close": ")" },
      { "open": "[", "close": "]" },
      { "open": "<", "close": ">" }
    ],
    "invalidPatterns": [";;", "#include\\s+[^\"<]"]
  },

  "commentStyles": ["//", "/*", "*/", "/**"]
}
