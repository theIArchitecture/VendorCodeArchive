RULE "NVIDIA-CUDA-MEMORY-LEAKS"
  ID: "NVIDIA-CUDA-MEMORY-002"
  DESCRIPTION: "CUDA memory allocation without corresponding free - potential memory leak"
  SEVERITY: Fatal
  CATEGORY: "NVIDIA_CUDA_Memory"
  APPLIES_TO: ["cuda", "cpp", "c"]

  PLUGIN:
    ID: "cuda-validator"
    CONFIG:
      validate_error_checking: false
      validate_memory_leaks: true

  EDUCATION:
    DOCS_URL: "https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#memory-management"
    WHY_IT_MATTERS: "GPU memory leaks exhaust device memory causing crashes and require expensive hardware resets"
    BUSINESS_IMPACT: "CUDA memory leaks waste millions in GPU compute time and cause production outages"
    QUICK_FIX: "Ensure every cudaMalloc has corresponding cudaFree, use RAII patterns"

  VIOLATIONS:
    - "cudaMalloc without corresponding cudaFree - potential memory leak"
    - "cudaMallocHost without cudaFreeHost - memory leak"
    - "cudaMallocManaged without cudaFree - memory leak"
    - "CUDA memory allocation without error check - potential leak if allocation fails"

END RULE
