RULE "NVIDIA-CUDA-ERROR-CHECKING"
  ID: "NVIDIA-CUDA-ERROR-001"
  DESCRIPTION: "CUDA API call without error checking - silent failures violate production standards"
  SEVERITY: Error
  CATEGORY: "NVIDIA_CUDA_ErrorHandling"
  APPLIES_TO: ["cuda", "cpp", "c"]

  PLUGIN:
    ID: "cuda-validator"
    CONFIG:
      validate_error_checking: true
      validate_memory_leaks: false

  EDUCATION:
    DOCS_URL: "https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#error-handling"
    WHY_IT_MATTERS: "Unchecked CUDA errors cause silent failures, corrupt data, and impossible-to-debug GPU issues"
    BUSINESS_IMPACT: "Silent CUDA failures waste hours of debugging time and cause data corruption in production systems"
    QUICK_FIX: "Check cudaError_t return value and call cudaGetLastError() after kernel launches"

  VIOLATIONS:
    - "cudaMalloc without error check - silent failure violates production standards"
    - "cudaMemcpy without error check - data corruption risk"
    - "Kernel launch without cudaGetLastError() - breaks error handling requirements"
    - "CUDA API call without proper error checking"

END RULE
