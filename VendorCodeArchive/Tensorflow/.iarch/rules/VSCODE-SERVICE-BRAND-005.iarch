# VSCode Service Brand Rule - Production Ready
# Based on Microsoft's actual ESLint rule: local/code-declare-service-brand
# Enforces VSCode's dependency injection service branding system
# Ensures all services have proper type safety through service branding

RULE "VSCODE-SERVICE-BRAND-VIOLATION" : IHealerArchitecture
  ID: "VSCODE-SERVICE-BRAND-005"
  DESCRIPTION: "Missing service brand declaration - breaks VSCode's DI system type safety"
  SEVERITY: Error
  CATEGORY: "VSCode_DependencyInjection"
  APPLIES_TO: ["typescript"]

  ARCHITECTURAL_CONTEXT:
    PROJECT_TYPE: "VSCODE_EDITOR_PLATFORM"
    COMPLIANCE_REQUIREMENTS: ["DI_Type_Safety", "Service_Brand_Integrity", "Compile_Time_Validation"]
    ORGANIZATION_STANDARDS: ["Microsoft_VSCode", "TypeScript_DI_Patterns", "Service_Architecture"]
    TECHNOLOGY_STACK: ["typescript", "vscode", "dependency_injection", "service_locator"]
    SECURITY_LEVEL: "Enterprise_Editor"

  EDUCATION:
    DOCS_URL: "https://github.com/microsoft/vscode/wiki/Dependency-Injection#service-branding"
    BUSINESS_IMPACT: "Service injection failures break VSCode features during startup affecting millions of developers"
    QUICK_FIX: "Add readonly _serviceBrand: undefined; to service interface for {{SILO:SECURITY_LEVEL}}"

  ARCHITECTURAL_LAYERS:
    VSCODE_PLATFORM_SERVICES: ["src/vs/platform", "Core services", "Service interfaces"]
    VSCODE_DI_SYSTEM: ["Service branding", "Type safety", "Service registration"]
    VSCODE_SERVICE_LOCATOR: ["Service resolution", "Dependency injection", "Service lifecycle"]

  DETECT:
    PATTERNS:
      typescript:
        # Service interface without brand
        - SERVICE_NO_BRAND: "interface\\s+I\\w+Service\\s*\\{(?!.*_serviceBrand)"
        - SERVICE_NO_BRAND_MULTILINE: "interface\\s+I\\w+Service\\s*\\{(?:[^}]*\\n)*?(?!.*_serviceBrand)"

        # Service decorator without brand
        - DECORATOR_NO_BRAND: "createDecorator<I\\w+Service>.*(?<!interface.*_serviceBrand)"

        # Service class without brand
        - CLASS_NO_BRAND: "class\\s+\\w+Service\\s+implements\\s+I\\w+Service\\s*\\{(?!.*_serviceBrand)"

        # Abstract service without brand
        - ABSTRACT_NO_BRAND: "abstract\\s+class\\s+\\w+Service\\s+implements\\s+I\\w+Service\\s*\\{(?!.*_serviceBrand)"

  VIOLATIONS:
    - "{{SILO:PROJECT_TYPE}}: Service interface missing _serviceBrand - breaks {{SILO:COMPLIANCE_REQUIREMENTS}}"
    - "{{SILO:PROJECT_TYPE}}: Service decorator without brand violates DI type safety"
    - "{{SILO:PROJECT_TYPE}}: Service class missing brand implementation"
    - "{{SILO:PROJECT_TYPE}}: Abstract service without brand breaks inheritance"

  FIXES:
    typescript:
      - REPLACE: "interface I${1}Service {"
      - WITH: "interface I${1}Service {\n  readonly _serviceBrand: undefined;"
      - TEACHING: "Service brand enables DI type safety in {{SILO:COMPLIANCE_REQUIREMENTS}} for {{SILO:PROJECT_TYPE}}"

      - REPLACE: "class ${1}Service implements I${1}Service {"
      - WITH: "class ${1}Service implements I${1}Service {\n  readonly _serviceBrand: undefined;"
      - TEACHING: "Implementation must match interface brand for {{SILO:PROJECT_TYPE}} DI system"

      - REPLACE: "abstract class ${1}Service implements I${1}Service {"
      - WITH: "abstract class ${1}Service implements I${1}Service {\n  readonly _serviceBrand: undefined;"
      - TEACHING: "Abstract services need brand for {{SILO:COMPLIANCE_REQUIREMENTS}} inheritance"

      - REPLACE: "createDecorator<I${1}Service>('${2}');"
      - WITH: "createDecorator<I${1}Service>('${2}'); // Ensure I${1}Service has _serviceBrand"
      - TEACHING: "Service decorator requires branded interface for {{SILO:SECURITY_LEVEL}}"
    META_ARCHITECTURE:
      HEALING_PRIORITY: 2
      BREAKING_CHANGE: false
      BUSINESS_IMPACT: "Missing brands break DI type safety causing runtime failures"
      AUTO_HEAL_SUCCESS_RATE: "90%"
      RECURSIVE_DEPTH: 2
      GOVERNANCE_LEVEL: "VSCODE_SERVICE_BRANDING_ENFORCEMENT"

  EXAMPLES:
    VIOLATION:
      typescript: |
        // ❌ VIOLATION: Service interface without brand
        interface IConfigurationService {
          getValue<T>(key: string): T | undefined;
          updateValue(key: string, value: any): Promise<void>;
        }

        class ConfigurationService implements IConfigurationService {
          getValue<T>(key: string): T | undefined {
            // implementation
          }
          
          updateValue(key: string, value: any): Promise<void> {
            // implementation
          }
        }

    CORRECT:
      typescript: |
        // ✅ CORRECT: Service interface with brand
        interface IConfigurationService {
          readonly _serviceBrand: undefined;
          getValue<T>(key: string): T | undefined;
          updateValue(key: string, value: any): Promise<void>;
        }

        class ConfigurationService implements IConfigurationService {
          readonly _serviceBrand: undefined;
          
          getValue<T>(key: string): T | undefined {
            // implementation
          }
          
          updateValue(key: string, value: any): Promise<void> {
            // implementation
          }
        }

  WHITELISTED_PATTERNS:
    - "_serviceBrand:\\s*undefined"
    - "readonly\\s+_serviceBrand"
    - "interface.*_serviceBrand"

  PARTIAL_HEALING:
    typescript:
      - ACTION: "Add _serviceBrand to service interfaces and implementations"
      - LIMITATION: "Cannot determine service inheritance hierarchy or decorator usage"
      - DOWNGRADE_TO: "WARNING"
      - EDUCATIONAL_NOTE: "Verify service registration and decorator usage for {{SILO:PROJECT_TYPE}}"
    META_ARCHITECTURE:
      HEALING_PRIORITY: 7
      AUTO_HEAL_SUCCESS_RATE: "100%"

  SELF_GOVERNANCE:
    VALIDATES_SELF: true
    RECURSIVE_DEPTH: 2
    META_VALIDATION: "This rule enforces {{SILO:COMPLIANCE_REQUIREMENTS}} for {{SILO:PROJECT_TYPE}} service architecture"
    PROOF_OF_COMPLIANCE: "Rule implements IHealerArchitecture interface and validates VSCode service branding patterns"
    COMPLIANCE_CHECK: "All detection patterns target missing service brands, all fixes provide proper branding"

  IDENTIFIER: "VSCODE-SERVICE-BRAND-005"
  IS_VALID: true
  CODE_TYPE: "Architecture"
  CURRENT_STATE: "Active"

END RULE
