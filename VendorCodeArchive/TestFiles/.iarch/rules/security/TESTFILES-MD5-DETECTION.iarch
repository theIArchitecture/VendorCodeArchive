# TestFiles Boundary Rule - MD5 Detection
# This rule exists ONLY at the TestFiles level to demonstrate hierarchical discovery
# Will only be discovered when using --discovery-root that includes TestFiles parent

RULE "MD5 usage detected in test files - use SHA256 instead" : IValidationArchitecture
  ID: "TESTFILES-MD5-DETECT"
  DESCRIPTION: "Detects MD5 cryptographic hash usage which is cryptographically broken. Use SHA256 or stronger."
  SEVERITY: Warning
  CATEGORY: "Security"
  APPLIES_TO: ["python", "csharp"]

  ARCHITECTURAL_CONTEXT:
    CATEGORY: "Security"
    LAYER: "Base"
    SOURCE: "TestFiles Boundary"

  DETECT:
    PATTERNS:
      python:
        # MD5 in Python hashlib
        - MD5_HASHLIB: "hashlib\\.md5\\s*\\("
        - MD5_IMPORT: "from\\s+hashlib\\s+import\\s+md5"

      csharp:
        # MD5 in C#
        - MD5_CREATE: "MD5\\.Create\\s*\\("
        - MD5_FIELD: "MD5\\s+\\w+"

  VIOLATIONS:
    - "MD5 cryptographic hash detected - MD5 is cryptographically broken (collision attacks proven). Use SHA256 or SHA512 for security-sensitive operations."

  EDUCATION:
    WHY_IT_MATTERS: "MD5 has known collision vulnerabilities and should not be used for security purposes. Attackers can create different inputs that produce the same MD5 hash."
    BUSINESS_IMPACT: "Use of broken cryptography can lead to security breaches and compliance failures."
    QUICK_FIX: "Replace hashlib.md5() with hashlib.sha256() or hashlib.sha512()"
    DOCS_URL: "https://en.wikipedia.org/wiki/MD5#Security"

  META_ARCHITECTURE:
    HEALING_PRIORITY: 5
    BREAKING_CHANGE: false
    EXTRACTED_FROM: "TestFiles Boundary Rule"

END RULE
