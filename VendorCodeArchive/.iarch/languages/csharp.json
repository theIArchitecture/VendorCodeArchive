{
  "$schema": "../schemas/language-definition.schema.json",
  "language": "csharp",
  "displayName": "C# (AWS SDK Configuration)",
  "fileExtensions": [".cs", ".csx"],

  "layerDetection": {
    "layers": {
      "Model": {
        "pathPatterns": ["model", "transfer", "entities", "dto"],
        "baseClassPatterns": ["ModelBase", "BaseModel", "RequestBase", "ResponseBase"],
        "interfacePatterns": ["IModel", "IRequest", "IResponse"],
        "namingPatterns": ["Request$", "Response$", "Model$", ".*Model.*"],
        "importPatterns": ["using.*\\.Model", "using.*\\.Transfer", "using.*\\.Entities"]
      },

      "Internal": {
        "pathPatterns": ["internal", "util", "utilities", "helpers"],
        "baseClassPatterns": ["InternalBase", "UtilityBase"],
        "interfacePatterns": ["IInternal"],
        "namingPatterns": ["Util$", "Helper$", "Internal.*"],
        "importPatterns": ["using.*\\.Internal", "using.*\\.Util"]
      },

      "Client": {
        "pathPatterns": ["services", "client", "clients"],
        "baseClassPatterns": ["AmazonServiceClient", "ClientBase", "ServiceClient"],
        "interfacePatterns": ["IAmazonService", "IClient"],
        "namingPatterns": ["Client$", ".*Client", ".*Service$"],
        "importPatterns": ["using.*\\.Services", "using Amazon\\..*"]
      }
    }
  },

  "syntaxPatterns": {
    "classDeclaration": "class\\s+(\\w+)\\s*(?::\\s*([^{,\\r\\n]+))?",
    "importStatement": "using\\s+(?:static\\s+)?([^;\\s]+);",
    "interfaceImplementation": ":\\s*[^{]*\\b(I\\w+Architecture|I\\w+)\\b",
    "methodDeclaration": "(public|private|protected|internal|static)\\s+(?:async\\s+)?(?:Task<[^>]+>|Task|\\w+)\\s+(\\w+)\\s*\\("
  },

  "fieldExtractionPatterns": [
    {
      "name": "field_declaration",
      "description": "Matches field declarations like: private Type _field;",
      "pattern": "(?:public\\s+|private\\s+|protected\\s+|internal\\s+)?(?:static\\s+)?(?:readonly\\s+)?(?:const\\s+)?(\\w+(?:<[\\w\\s,<>]+>)?)\\s+(_?\\w+)\\s*(?:;|=|{)",
      "typeGroup": 1,
      "nameGroup": 2,
      "isProperty": false
    },
    {
      "name": "property_declaration",
      "description": "Matches property declarations like: public Type Property { get; set; }",
      "pattern": "(?:public\\s+|private\\s+|protected\\s+|internal\\s+)?(?:static\\s+)?(?:readonly\\s+)?(\\w+(?:<[\\w\\s,<>]+>)?)\\s+(\\w+)\\s*\\{",
      "typeGroup": 1,
      "nameGroup": 2,
      "isProperty": true
    }
  ],

  "parsingPatterns": {
    "namespace": "^\\s*namespace\\s+([\\w\\.]+)",
    "import": "^\\s*using\\s+(?<modifier>static\\s+)?(?<module>[\\w\\.]+)\\s*;",
    "typeDeclaration": "(?:public\\s+|private\\s+|protected\\s+|internal\\s+)?(?:static\\s+)?(?:sealed\\s+)?(?:abstract\\s+)?(class|interface|enum|struct|record)\\s+(\\w+)(?:\\s*<[^>]+>)?(?:\\s*:\\s*([^{]+))?",
    "typeKeywords": ["class", "interface", "enum", "struct", "record"],
    "methodDeclaration": "(?:public\\s+|private\\s+|protected\\s+|internal\\s+)?(?:static\\s+)?(?:virtual\\s+)?(?:override\\s+)?(?:async\\s+)?(\\w+(?:<[\\w\\s,<>]+>)?)\\s+(\\w+)\\s*\\(([^)]*)\\)",
    "instantiation": "new\\s+([\\w\\.]+)(?:<[^>]+>)?\\s*\\(",
    "commentSingleLine": "//(.*)$",
    "commentMultiLine": "/\\*(.*?)\\*/",
    "commentDocumentation": "///(.*)$"
  },

  "transformationRules": {
    "importTemplate": "using {namespace};",
    "importInsertLocation": "after_last_import",
    "importRemovalPattern": "^\\s*using\\s+{namespace}\\s*;\\s*$"
  },

  "formattingRules": {
    "indentSize": 4,
    "increaseIndentTriggers": ["{"],
    "decreaseIndentTriggers": ["}"],
    "decreaseBeforeLine": true
  },

  "syntaxValidation": {
    "balancedPairs": [
      { "open": "{", "close": "}" },
      { "open": "(", "close": ")" },
      { "open": "[", "close": "]" }
    ],
    "invalidPatterns": [";;", "using\\s+[^;]*$"]
  },

  "commentStyles": ["//", "/*", "*/", "///", "/**"]
}
